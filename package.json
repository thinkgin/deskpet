{
  "name": "cartoonwife",
  "productName": "桌面宠物·陪伴",
  "version": "1.26.0",
  "description": "Pixel desktop pet for emotional companionship",
  "main": "main.js",
  "author": "cartoonwife",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "preview": "node scripts/preview-pet.js",
    "build:3d": "esbuild src/renderer/pet3d-src.js --bundle --format=iife --outfile=src/renderer/pet3d.js --define:process.env.NODE_ENV='\"production\"' --minify",
    "pack": "npm run build:3d && electron-builder --win nsis --x64",
    "pack:dir": "npm run build:3d && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "three": "^0.185.1"
  },
  "build": {
    "appId": "com.cartoonwife.pet",
    "productName": "Desktop Pet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "cartoonwife-pet",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "桌面宠物·陪伴",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
