{
  "name": "cartoonwife",
  "productName": "桌面宠物·陪伴",
  "version": "1.15.0",
  "description": "Pixel desktop pet for emotional companionship",
  "main": "main.js",
  "author": "cartoonwife",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "preview": "node scripts/preview-pet.js",
    "pack": "electron-builder --win nsis --x64",
    "pack:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cartoonwife.pet",
    "productName": "Desktop Pet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "cartoonwife-pet",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "桌面宠物·陪伴",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
